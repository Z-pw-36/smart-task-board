APP_NAME=Smart Task Board API
APP_ENV=development
APP_DEBUG=false
APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO
POSTGRES_DB=smart_task_board
POSTGRES_USER=smart_task_board
POSTGRES_PASSWORD=change-me-before-starting-postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://smart_task_board:change-me-before-starting-postgres@localhost:5432/smart_task_board
AUTH_MODE=prototype
PROTOTYPE_AUTH_ENABLED=true
PROTOTYPE_USER_EMPLOYEE_NOS=E-CREATOR,E-ASSIGNEE,E-REVIEWER,E-OBSERVER
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ISSUER=smart-task-board
JWT_AUDIENCE=smart-task-board-web
JWT_EXPIRE_MINUTES=30
ALLOW_TEST_EMPLOYEE_HEADER=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
